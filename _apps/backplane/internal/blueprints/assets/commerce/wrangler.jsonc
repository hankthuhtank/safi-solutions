// Worker configuration — generated by Backplane for {{param:project_name}} ({{env}}).
// Secrets are NOT stored here. They live encrypted in Cloudflare (set by
// Backplane) and survive every deploy.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "{{out:api.name}}",
  "main": "src/index.js",
  "compatibility_date": "{{param:compatibility_date}}",
  "workers_dev": true,
  "observability": { "enabled": true },
  "r2_buckets": [{ "binding": "DOWNLOADS", "bucket_name": "{{out:downloads.name}}" }],
  "kv_namespaces": [{ "binding": "PROBES", "id": "{{out:probes.id}}" }],
  "triggers": { "crons": ["17 3 * * *"] },
  "vars": {
    "WORKER_NAME": "{{out:api.name}}",
    "PRODUCT_NAME": "{{param:product_name}}",
    "PRODUCT_FILE_KEY": "{{param:product_file_key}}",
    "PRICE_ID": "{{out:price.id}}",
    "SUPABASE_URL": "{{out:db.url}}",
    "FROM_EMAIL": "{{param:from_email}}",
    "SUPPORT_EMAIL": "{{param:support_email}}",
    "BUSINESS_NAME": "{{param:business_name}}",
    "SITE_ORIGIN": "{{param:site_origin}}",
    "SUCCESS_URL": "{{param:success_url}}",
    "CANCEL_URL": "{{param:cancel_url}}",
    "DOWNLOAD_TTL_HOURS": "{{param:download_ttl_hours}}",
    "MAX_DOWNLOADS": "{{param:max_downloads}}",
    "LICENSE_MODE": "{{param:license_mode}}",
    "RESEND_TEMPLATE_PURCHASE": "{{out:email_purchase.id}}"
  }
}

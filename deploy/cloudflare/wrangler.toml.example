name = "safisolutions-downloads"
main = "worker.js"
compatibility_date = "2026-09-18"

routes = [
  { pattern = "www.safisolutions.org/api/*", zone_name = "safisolutions.org" },
  { pattern = "safisolutions.org/api/*", zone_name = "safisolutions.org" }
]

[[r2_buckets]]
binding = "PRODUCTS"
bucket_name = "safisolutions-products"

[vars]
DOWNLOAD_TTL_SECONDS = "3600"
ORDER_TO_EMAIL = "safihelal@gmail.com"
ORDER_FROM_EMAIL = "SafiSolutions Orders <orders@safisolutions.org>"

# Set these to the exact private R2 object keys after upload.
PRODUCT_FILE_PADEFF = "padeff/Padeff-1.0.zip"
PRODUCT_FILE_PIKTOOR = "piktoor/Piktoor-1.0.zip"
PRODUCT_FILE_KWEZEEN = "kwezeen/Kwezeen-1.0.zip"
PRODUCT_FILE_DOQCORP = "doqcorp/DoqCorp-1.0.zip"
PRODUCT_FILE_BRANDUR = "brandur/Brandur-1.0.zip"
